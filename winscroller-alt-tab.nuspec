    <file src="docs\preview.png" target="docs\preview.png" />
    <file src="README.md" target="README.md" />
    <file src="LICENSE" target="LICENSE" />
    <file src="KEYBINDINGS.md" target="KEYBINDINGS.md" />
  </files>
</package>
